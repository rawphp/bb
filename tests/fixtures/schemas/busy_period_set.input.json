{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "description": "A client-made ULID (CAP-019)."
        },
        "label": {
            "type": "string"
        },
        "start": {
            "type": "string",
            "description": "24-hour \"HH:MM\"."
        },
        "end": {
            "type": "string"
        },
        "weekdays": {
            "type": "array",
            "description": "ISO weekdays it repeats on; 1 is Monday."
        }
    },
    "required": [
        "id",
        "label",
        "start",
        "end",
        "weekdays"
    ]
}
