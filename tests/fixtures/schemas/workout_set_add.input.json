{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "set_id": {
            "type": "string"
        },
        "workout_exercise_id": {
            "type": "string"
        },
        "after_set_id": {
            "type": [
                "string",
                "null"
            ]
        },
        "set_type": {
            "type": "string",
            "enum": [
                "regular_straight",
                "regular_down",
                "regular_ascending",
                "myorep",
                "myorep_match"
            ]
        }
    },
    "required": [
        "set_id",
        "workout_exercise_id",
        "set_type",
        "after_set_id"
    ]
}
