{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "phase_id": {
            "type": "string"
        },
        "type": {
            "type": "string",
            "enum": [
                "fat_loss",
                "muscle_gain",
                "maintenance",
                "mini_cut"
            ]
        },
        "weeks": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 1
        },
        "rate_percent_per_week": {
            "type": [
                "number",
                "null"
            ]
        }
    },
    "required": [
        "phase_id",
        "type"
    ]
}
