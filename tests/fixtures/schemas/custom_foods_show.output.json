{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "foods": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "food_id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "detail": {
                        "type": "string",
                        "description": "1 cup · 120 kcal"
                    },
                    "brand": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "barcode": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "serving_size": {
                        "type": "number"
                    },
                    "serving_unit": {
                        "type": "string",
                        "enum": [
                            "g",
                            "cup",
                            "tbsp",
                            "tsp",
                            "piece"
                        ]
                    },
                    "serving_grams": {
                        "type": "number"
                    },
                    "protein": {
                        "type": "number"
                    },
                    "fat": {
                        "type": "number"
                    },
                    "carbs": {
                        "type": "number"
                    },
                    "fiber": {
                        "type": "number"
                    }
                },
                "required": [
                    "food_id",
                    "name",
                    "detail",
                    "serving_size",
                    "serving_unit",
                    "serving_grams",
                    "protein",
                    "fat",
                    "carbs",
                    "fiber"
                ]
            }
        },
        "empty_text": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "required": [
        "foods"
    ]
}
