{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "already_in_meal": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "food_id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "food_id",
                    "name"
                ]
            }
        },
        "sections": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "title": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "group": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "One of: protein_recommended, protein_sparingly, protein_before_bed, veggies, carbs_recommended, carbs_sparingly, fat_recommended, fat_sparingly; or null"
                    },
                    "show_more_title": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "rows": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "food_id": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "detail": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "description": "The brand or restaurant"
                                },
                                "raw": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "kcal": {
                                            "type": "string"
                                        },
                                        "protein": {
                                            "type": "string"
                                        },
                                        "fat": {
                                            "type": "string"
                                        },
                                        "carbs": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "kcal",
                                        "protein",
                                        "fat",
                                        "carbs"
                                    ]
                                },
                                "cooked": {
                                    "type": [
                                        "object",
                                        "null"
                                    ],
                                    "additionalProperties": false,
                                    "properties": {
                                        "kcal": {
                                            "type": "string"
                                        },
                                        "protein": {
                                            "type": "string"
                                        },
                                        "fat": {
                                            "type": "string"
                                        },
                                        "carbs": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "kcal",
                                        "protein",
                                        "fat",
                                        "carbs"
                                    ],
                                    "description": "Null when the food has no cooked value, so it has no Raw/Cooked toggle"
                                },
                                "basis_text": {
                                    "type": "string",
                                    "description": "per 100 g, or per 3.5 oz"
                                },
                                "is_curated": {
                                    "type": "boolean"
                                },
                                "is_favorite": {
                                    "type": "boolean"
                                },
                                "is_in_meal": {
                                    "type": "boolean"
                                },
                                "attribution": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "description": "The credit the food's dataset asks for, from Food::attribution(); shown in the food detail (ODbL for Open Food Facts). Null when the food's source is curated or custom; an imported food marked curated keeps its dataset's credit"
                                }
                            },
                            "required": [
                                "food_id",
                                "name",
                                "raw",
                                "basis_text",
                                "is_curated",
                                "is_favorite",
                                "is_in_meal"
                            ]
                        }
                    }
                },
                "required": [
                    "id",
                    "rows"
                ]
            }
        },
        "recipes": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "recipe_id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "meal_type_title": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "macros_text": {
                        "type": "string",
                        "description": "330 kcal \u00b7 P 28 \u00b7 F 3 \u00b7 C 47, per serving"
                    },
                    "is_library": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "recipe_id",
                    "name",
                    "macros_text",
                    "is_library"
                ]
            }
        },
        "saved_meals": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "saved_meal_id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "detail": {
                        "type": "string",
                        "description": "3 foods"
                    }
                },
                "required": [
                    "saved_meal_id",
                    "name",
                    "detail"
                ]
            }
        },
        "suggestion": {
            "type": [
                "object",
                "null"
            ],
            "additionalProperties": false,
            "properties": {
                "text": {
                    "type": "string",
                    "description": "Did you mean chicken breast?"
                },
                "query": {
                    "type": "string"
                }
            },
            "required": [
                "text",
                "query"
            ]
        },
        "create_custom_food": {
            "type": [
                "object",
                "null"
            ],
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "title",
                "name"
            ]
        },
        "diets": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "key": {
                        "type": "string",
                        "enum": [
                            "dairy_free",
                            "gluten_free",
                            "grain_free",
                            "low_fodmap",
                            "vegetarian",
                            "paleo",
                            "vegan"
                        ]
                    },
                    "title": {
                        "type": "string"
                    },
                    "is_on": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "key",
                    "title",
                    "is_on"
                ]
            }
        },
        "empty_text": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "required": [
        "already_in_meal",
        "sections",
        "recipes",
        "saved_meals",
        "diets"
    ]
}
