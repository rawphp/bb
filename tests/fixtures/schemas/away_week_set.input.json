{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "week_starts": {
            "type": "array",
            "description": "Plan week starts, \"YYYY-MM-DD\"."
        },
        "away": {
            "type": "boolean"
        },
        "training": {
            "type": "string",
            "enum": [
                "pause",
                "deload"
            ]
        },
        "calories": {
            "type": "string",
            "enum": [
                "rest",
                "maintenance"
            ]
        },
        "keep_phase_end": {
            "type": [
                "boolean",
                "null"
            ],
            "description": "True leaves the phase end where it is when a week becomes a diet break (PLAN-025). Left out (null, not false), each week keeps what it was saved with. A diet break that moved the end always gives that week back once it is no longer one."
        }
    },
    "required": [
        "week_starts",
        "away"
    ]
}
