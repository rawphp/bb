    "type": "object",
    "additionalProperties": false,
    "properties": {
        "invalidates": {
            "type": "array",
            "description": "read keys whose data changed (CAP-010)"
        },
        "toast": {
            "type": [
                "string",
                "null"
            ]
        },
        "undo": {
            "type": [
