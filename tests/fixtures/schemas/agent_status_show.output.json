{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "available": {
            "type": "boolean",
            "description": "the instance has the agent on (AGT-002)"
        },
        "on": {
            "type": "boolean",
            "description": "available and this user has not turned it off (AGT-020)"
        },
        "status": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "text": {
                    "type": "string"
                },
                "tone": {
                    "type": "string",
                    "enum": [
                        "good",
                        "neutral",
                        "warning",
                        "info"
                    ]
                }
            },
            "required": [
                "text",
                "tone"
            ]
        },
        "usage": {
            "type": [
                "object",
                "null"
            ],
            "additionalProperties": false,
            "properties": {
                "text": {
                    "type": "string"
                },
                "tone": {
                    "type": "string",
                    "enum": [
                        "good",
                        "neutral",
                        "warning",
                        "info"
                    ]
                }
            },
            "required": [
                "text",
                "tone"
            ],
            "description": "what is left of the caps; null when uncapped (AGT-005)"
        },
        "note": {
            "type": "string",
            "description": "what the Coach can and cannot do (AGT-020)"
        },
        "has_conversation": {
            "type": "boolean"
        }
    },
    "required": [
        "available",
        "on",
        "status",
        "note",
        "has_conversation"
    ]
}
