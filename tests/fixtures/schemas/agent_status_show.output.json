{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "enabled": {
            "type": "boolean"
        },
        "turns_left": {
            "type": [
                "integer",
                "null"
            ]
        },
        "tokens_left": {
            "type": [
                "integer",
                "null"
            ]
        },
        "at_cap": {
            "type": "boolean"
        },
        "resets_at": {
            "type": [
                "string",
                "null"
            ]
        },
        "notice": {
            "type": [
                "object",
                "null"
            ],
            "additionalProperties": false,
            "properties": {
                "text": {
                    "type": "string"
                },
                "tone": {
                    "type": "string",
                    "enum": [
                        "good",
                        "neutral",
                        "warning",
                        "info"
                    ]
                }
            },
            "required": [
                "text",
                "tone"
            ]
        }
    },
    "required": [
        "enabled",
        "at_cap"
    ]
}
