{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "description": "A client-made ULID (CAP-019)."
        },
        "date": {
            "type": "string",
            "format": "date"
        },
