{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "mesocycle_id": {
            "type": "string"
        },
        "weeks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
        },
        "expected_weeks": {
            "type": "integer",
            "description": "The weeks_count mesocycle_show last gave; refused when the length has moved since",
            "minimum": 1,
            "maximum": 8
        }
    },
    "required": [
        "mesocycle_id",
        "weeks",
        "expected_weeks"
    ]
}
