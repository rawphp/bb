{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "week_start": {
            "type": "string",
            "format": "date"
        },
        "option": {
            "type": [
                "string",
                "null"
            ],
            "description": "The calorie option; left out, the answer sets own_kcal on the stored choose_own and clears its moves, as a new amount does.",
            "enum": [
                "recommendation",
                "repeat_this_week",
                "choose_own",
                "drop_fatigue",
                "cut_calories",
                "add_steps",
                null
            ]
        },
        "own_kcal": {
            "type": [
                "integer",
                "null"
            ],
            "description": "Average kcal a day for choose_own; null leaves it to be sent, and review_complete waits for it. While choose_own waits for it, the suggested amount sent with a new step offer or deload answer, or new moves, is read as not yet chosen; send it alone, or with no change but cleared moves, to choose it.",
            "minimum": 1,
            "maximum": 10000
        },
        "deload_too": {
            "type": [
                "boolean",
                "null"
            ],
            "description": "REV-011: \"Make this your deload week too?\"; null for the default."
        },
        "update_step_plan": {
            "type": "boolean",
            "description": "REV-050: update the step plan to the walked average."
        },
        "moves": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "from_index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 6
                    },
                    "to_index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 6
                    },
                    "kcal": {
                        "type": "integer",
                        "minimum": 25,
                        "maximum": 500
                    }
                },
                "required": [
                    "from_index",
                    "to_index",
                    "kcal"
                ]
            },
            "description": "REV-004: calorie moves, applied in order."
        }
    },
    "required": [
        "week_start"
    ]
}
