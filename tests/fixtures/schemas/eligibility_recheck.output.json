{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "outcome": {
            "type": "string",
            "enum": [
                "keep",
                "switchToTrainingOnly",
                "runNutritionSetup",
                "leaveFatLoss"
            ]
        },
        "message": {
            "type": "string"
        },
        "next": {
            "type": "string",
            "description": "onboarding: onboarding_show holds the steps this outcome needs",
            "enum": [
                "done",
                "onboarding"
            ]
        },
        "invalidates": {
            "type": "array"
        },
        "toast": {
            "type": [
                "string",
                "null"
            ]
        },
        "undo": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "required": [
        "outcome",
        "message",
        "next",
        "invalidates"
    ]
}
