{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "mesocycle_id": {
            "type": "string"
        },
        "choice": {
            "type": "string",
            "enum": [
                "restart",
                "end"
            ]
        },
        "diet_break": {
            "type": "boolean",
            "description": "End only: start a diet break next week."
        }
    },
    "required": [
        "mesocycle_id",
        "choice"
    ]
}
