{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "exercise_id": {
            "type": "string"
        },
        "step": {
            "type": [
                "number",
                "null"
            ],
            "minimum": 0.25
        },
        "unit": {
            "type": "string",
            "enum": [
                "kg",
                "lb"
            ]
        }
    },
    "required": [
        "exercise_id",
        "unit",
        "step"
    ]
}
