{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
        },
        "muscle_group": {
            "type": "string",
            "enum": [
                "chest",
                "back",
                "quads",
                "hamstrings",
                "glutes",
                "sideDelts",
                "rearDelts",
                "frontDelts",
                "biceps",
                "triceps",
                "calves",
                "abs",
                "traps",
                "forearms"
            ]
        },
        "equipment": {
            "type": "string",
            "enum": [
                "barbell",
                "ezBar",
                "trapBar",
                "dumbbell",
                "kettlebell",
                "machine",
                "cable",
                "smithMachine",
                "bodyweight"
            ]
        },
        "load_type": {
            "type": "string",
            "enum": [
                "barbell",
                "dumbbell",
                "machine",
                "cable",
                "bodyweight",
                "bodyweightPlusLoad",
                "smithMachine"
            ]
        },
        "exercise_id": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "required": [
        "name",
        "muscle_group",
        "equipment",
        "load_type"
    ]
}
