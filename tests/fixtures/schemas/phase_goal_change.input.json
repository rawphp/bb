{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "phase_id": {
            "type": "string"
        },
        "type": {
            "type": "string",
            "enum": [
                "fatLoss",
                "muscleGain",
                "maintenance",
                "miniCut"
            ]
        },
        "new_phase_id": {
            "type": "string"
        }
    },
    "required": [
        "phase_id",
        "type",
        "new_phase_id"
    ]
}
