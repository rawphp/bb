{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "date": {
            "type": "string",
            "format": "date"
        },
        "steps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
        }
    },
    "required": [
        "date",
        "steps"
    ]
}
