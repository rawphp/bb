{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "mesocycle_id": {
            "type": "string"
        },
        "week": {
            "type": "integer"
        },
        "day": {
            "type": "integer"
        },
        "date": {
            "type": "string",
            "description": "The day it moves to.",
            "format": "date"
        }
    },
    "required": [
        "mesocycle_id",
        "week",
        "day",
        "date"
    ]
}
