{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "template_id": {
            "type": [
                "string",
                "null"
            ]
        },
        "days": {
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "2",
                "3",
                "4",
                "5",
                "6"
            ]
        },
        "sex": {
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "female",
                "male"
            ]
        },
        "focus": {
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "whole_body",
                "emphasis"
            ]
        },
        "phase": {
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "cut",
                "gain",
                "maintain",
                "all"
            ]
        }
    }
}
