includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # Per checkout: the default /tmp/phpstan is shared by every worktree on a machine,
    # and a cache written by one checkout's vendor breaks analysis in another.
    tmpDir: storage/framework/cache/phpstan
    paths:
        - app
        - bootstrap/app.php
        - routes
        - tests/Support
