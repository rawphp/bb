includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # Each checkout keeps its own cache, so a cache left by a deleted
    # checkout cannot point PHPStan at files that are gone.
    tmpDir: storage/framework/cache/phpstan
    paths:
        - app
        - bootstrap/app.php
        - routes
        - tests/Support
