includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - bootstrap/app.php
        - routes
        - tests/Support
    # Per checkout: a shared /tmp/phpstan cache made by another (since removed)
    # checkout breaks analysis with "stub is not a file".
    tmpDir: storage/framework/cache/phpstan
