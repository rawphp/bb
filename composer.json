{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "rawphp/bodybuilder",
    "type": "project",
    "description": "An open-source training and nutrition PWA.",
    "keywords": [
        "training",
        "nutrition",
        "pwa"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "halaxa/json-machine": "^1.2",
        "laravel-notification-channels/webpush": "^13.0",
        "laravel/framework": "^13.17",
        "laravel/mcp": "^1.1",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "rawphp/laravel-capabilities": "0.11.0",
        "rawphp/laravel-capabilities-ai": "0.11.0",
        "stripe/stripe-php": "^22.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "rawphp/warp": "^0.7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "bash scripts/provision.sh"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/rawphp/laravel-capabilities",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/rawphp/laravel-capabilities-ai",
            "no-api": true
        }
    ]
}
