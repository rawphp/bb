APP_NAME=Bodybuilder
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://bodybuilder.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bodybuilder
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Agent (rawphp/laravel-capabilities-ai). Tests pin the fake driver in phpunit.xml.
CAPABILITIES_AI_LLM_DRIVER=fake
ANTHROPIC_API_KEY=
# Per-user agent caps (AGT-005). Empty means no cap.
AGENT_TURNS_PER_DAY=
AGENT_TOKENS_PER_MONTH=

# Web Push. Generate once with `php artisan webpush:vapid`; changing them drops every subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Billing. Off for self-hosted instances; the Stripe keys are read only when it is on.
BILLING_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# The Stripe price ID of each plan sold; an empty one is not offered.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SIX_MONTHS=
STRIPE_PRICE_YEARLY=
